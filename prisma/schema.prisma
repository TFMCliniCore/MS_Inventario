generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @db.VarChar(100)
  descripcion String?    @db.VarChar(500)
  eliminado   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  productos   Producto[]

  @@map("categorias")
}

model Producto {
  id               Int               @id @default(autoincrement())
  nombre           String            @db.VarChar(200)
  descripcion      String?           @db.VarChar(1000)
  codigoBarras     String?           @unique @db.VarChar(100)
  codigoInterno    String?           @unique @db.VarChar(100)
  marca            String?           @db.VarChar(100)
  fabricante       String?           @db.VarChar(200)
  precioCompra     Decimal?          @db.Decimal(10, 2)
  precioVenta      Decimal           @db.Decimal(10, 2)
  cantidadActual   Int               @default(0)
  cantidadMinima   Int               @default(0)
  cantidadMaxima   Int?
  fechaVencimiento DateTime?
  imagen           String?           @db.VarChar(500)
  eliminado        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  categoriaId      Int?
  sucursalId       Int?
  categoria        Categoria?        @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  movimientos      MovimientoStock[]

  @@map("productos")
}

model MovimientoStock {
  id                Int      @id @default(autoincrement())
  tipo              String   @db.VarChar(20)
  cantidad          Int
  cantidadAnterior  Int
  cantidadPosterior Int
  motivo            String?  @db.VarChar(500)
  usuarioId         Int?
  sucursalId        Int?
  productoId        Int
  createdAt         DateTime @default(now())
  producto          Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@map("movimientos_stock")
}